final isarSchemasProvider = Provider<List<CollectionSchema<dynamic>>>((ref) {
  return appIsarSchemas;
});

final appDatabaseProvider = FutureProvider<Isar>((ref) async {
  return AppDatabase.open(schemas: ref.watch(isarSchemasProvider));
});
