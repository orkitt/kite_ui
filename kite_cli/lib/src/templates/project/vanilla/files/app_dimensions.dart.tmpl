import 'package:flutter/widgets.dart';

/// Shared layout metrics based on a 4px spacing grid.
///
/// Naming:
/// - s16      -> raw spacing value
/// - r16      -> raw radius value
/// - radius16 -> reusable BorderRadius
/// - pad16    -> all-side padding
/// - box16    -> square SizedBox (width & height)
/// - boxV16   -> vertical SizedBox (height only)
/// - boxH16   -> horizontal SizedBox (width only)
///

abstract final class AppDimensions {
  // Raw spacing ---------------------------------------------------------------
  static const double s4 = 4;
  static const double s8 = 8;
  static const double s12 = 12;
  static const double s16 = 16;
  static const double s20 = 20;
  static const double s24 = 24;
  static const double s32 = 32;
  static const double s40 = 40;
  static const double s48 = 48;

  // Raw radius ----------------------------------------------------------------
  static const double r4 = 4;
  static const double r8 = 8;
  static const double r12 = 12;
  static const double r16 = 16;
  static const double r20 = 20;
  static const double r24 = 24;
  static const double rFull = 999;

  // BorderRadius ---------------------------------------------------------------
  static const BorderRadius radius4 = BorderRadius.all(Radius.circular(r4));
  static const BorderRadius radius8 = BorderRadius.all(Radius.circular(r8));
  static const BorderRadius radius12 = BorderRadius.all(Radius.circular(r12));
  static const BorderRadius radius16 = BorderRadius.all(Radius.circular(r16));
  static const BorderRadius radius20 = BorderRadius.all(Radius.circular(r20));
  static const BorderRadius radius24 = BorderRadius.all(Radius.circular(r24));
  static const BorderRadius radiusFull = BorderRadius.all(
    Radius.circular(rFull),
  );

  // All-side padding -----------------------------------------------------------
  static const EdgeInsets pad4 = EdgeInsets.all(s4);
  static const EdgeInsets pad8 = EdgeInsets.all(s8);
  static const EdgeInsets pad12 = EdgeInsets.all(s12);
  static const EdgeInsets pad16 = EdgeInsets.all(s16);
  static const EdgeInsets pad20 = EdgeInsets.all(s20);
  static const EdgeInsets pad24 = EdgeInsets.all(s24);
  static const EdgeInsets pad32 = EdgeInsets.all(s32);

  // Square SizedBox ------------------------------------------------------------
  static const SizedBox box4 = SizedBox(width: s4, height: s4);
  static const SizedBox box8 = SizedBox(width: s8, height: s8);
  static const SizedBox box12 = SizedBox(width: s12, height: s12);
  static const SizedBox box16 = SizedBox(width: s16, height: s16);
  static const SizedBox box20 = SizedBox(width: s20, height: s20);
  static const SizedBox box24 = SizedBox(width: s24, height: s24);
  static const SizedBox box32 = SizedBox(width: s32, height: s32);
  static const SizedBox box40 = SizedBox(width: s40, height: s40);
  static const SizedBox box48 = SizedBox(width: s48, height: s48);

  // Vertical SizedBox (Height) -------------------------------------------------
  static const SizedBox boxV4 = SizedBox(height: s4);
  static const SizedBox boxV8 = SizedBox(height: s8);
  static const SizedBox boxV12 = SizedBox(height: s12);
  static const SizedBox boxV16 = SizedBox(height: s16);
  static const SizedBox boxV20 = SizedBox(height: s20);
  static const SizedBox boxV24 = SizedBox(height: s24);
  static const SizedBox boxV32 = SizedBox(height: s32);
  static const SizedBox boxV40 = SizedBox(height: s40);
  static const SizedBox boxV48 = SizedBox(height: s48);

  // Horizontal SizedBox (Width) ------------------------------------------------
  static const SizedBox boxH4 = SizedBox(width: s4);
  static const SizedBox boxH8 = SizedBox(width: s8);
  static const SizedBox boxH12 = SizedBox(width: s12);
  static const SizedBox boxH16 = SizedBox(width: s16);
  static const SizedBox boxH20 = SizedBox(width: s20);
  static const SizedBox boxH24 = SizedBox(width: s24);
  static const SizedBox boxH32 = SizedBox(width: s32);
  static const SizedBox boxH40 = SizedBox(width: s40);
  static const SizedBox boxH48 = SizedBox(width: s48);
}
