{
  "schemaVersion": 2,
  "id": "project.clean",
  "version": "1.3.0",
  "description": "Kite UI, Riverpod, GoRouter, shared states, failures, and project configuration.",
  "dependencies": [
    "kite",
    "lucide_icons_flutter",
    "go_router"
  ],
  "devDependencies": [],
  "files": [
    {
      "template": "files/main.dart.tmpl",
      "target": "{{config.sourceDirectory}}/main.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/app.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/bootstrap.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/bootstrap.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_router.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/router/app_router.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_routes.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/router/app_routes.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/navigator_observer.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/router/navigator_observer.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/generated/root_routes.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/router/generated/root_routes.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/generated/generated_routes.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/router/generated/generated_routes.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_theme.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/theme/app_theme.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_colors.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/theme/app_colors.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_typography.dart.tmpl",
      "target": "{{config.sourceDirectory}}/app/theme/app_typography.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_exception.dart.tmpl",
      "target": "{{config.sourceDirectory}}/core/errors/app_exception.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_failure.dart.tmpl",
      "target": "{{config.sourceDirectory}}/core/errors/app_failure.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/result.dart.tmpl",
      "target": "{{config.sourceDirectory}}/core/types/result.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/extensions.dart.tmpl",
      "target": "{{config.sourceDirectory}}/core/extensions/extensions.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/functional_extensions.dart.tmpl",
      "target": "{{config.sourceDirectory}}/core/extensions/functional_extensions.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_loading_view.dart.tmpl",
      "target": "{{config.sourceDirectory}}/shared/widgets/app_loading_view.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_error_view.dart.tmpl",
      "target": "{{config.sourceDirectory}}/shared/widgets/app_error_view.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_empty_view.dart.tmpl",
      "target": "{{config.sourceDirectory}}/shared/widgets/app_empty_view.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/app_startup_view.dart.tmpl",
      "target": "{{config.sourceDirectory}}/shared/widgets/app_startup_view.dart",
      "upgradePolicy": "replace"
    },
    {
      "template": "files/gitkeep.tmpl",
      "target": "{{config.featureDirectory}}/.gitkeep",
      "upgradePolicy": "preserve"
    },
    {
      "template": "files/kite.yaml.tmpl",
      "target": "kite.yaml",
      "upgradePolicy": "preserve"
    }
  ],
  "requires": [
    "state.riverpod",
    "foundation.core"
  ]
}
