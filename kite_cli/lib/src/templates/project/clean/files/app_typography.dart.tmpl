import 'package:flutter/material.dart';
import 'package:kite/kite_ui.dart';

/// Application typography built on Kite.
///
/// Usage:
/// ```dart
/// final typography = context.typography;
/// ```
abstract final class AppTypography {
  AppTypography._();

  static const KiteTypography typography = KiteTypography(
    // Hero and high-emphasis display text.
    display: TextStyle(
      fontSize: 32,
      fontWeight: FontWeight.w700,
      height: 1.20,
      letterSpacing: -0.80,
    ),

    // Primary page or screen heading.
    heading: TextStyle(
      fontSize: 24,
      fontWeight: FontWeight.w700,
      height: 1.25,
      letterSpacing: -0.50,
    ),

    // Section, dialog, and sheet heading.
    section: TextStyle(
      fontSize: 18,
      fontWeight: FontWeight.w600,
      height: 1.35,
      letterSpacing: -0.20,
    ),

    // Card, list, and component title.
    title: TextStyle(
      fontSize: 16,
      fontWeight: FontWeight.w600,
      height: 1.40,
      letterSpacing: -0.10,
    ),

    // Prominent descriptive content.
    lead: TextStyle(fontSize: 16, fontWeight: FontWeight.w400, height: 1.50),

    // Default readable application content.
    body: TextStyle(fontSize: 14, fontWeight: FontWeight.w400, height: 1.45),

    // Compact supporting content.
    paragraph: TextStyle(
      fontSize: 13,
      fontWeight: FontWeight.w400,
      height: 1.40,
    ),

    // Buttons, fields, navigation, and controls.
    label: TextStyle(
      fontSize: 14,
      fontWeight: FontWeight.w600,
      height: 1.20,
      letterSpacing: 0.10,
    ),

    // Tabs, chips, badges, and compact controls.
    labelSmall: TextStyle(
      fontSize: 12,
      fontWeight: FontWeight.w600,
      height: 1.20,
      letterSpacing: 0.10,
    ),

    // Metadata, timestamps, and helper text.
    caption: TextStyle(
      fontSize: 11,
      fontWeight: FontWeight.w400,
      height: 1.30,
      letterSpacing: 0.15,
    ),
  );
}
