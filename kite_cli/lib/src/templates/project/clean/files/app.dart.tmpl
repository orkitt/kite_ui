import 'package:flutter/material.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';
import 'package:kite/kite_ui.dart';

import '../core/constants/app_constants.dart';
import 'router/app_router.dart';
import 'theme/app_theme.dart';
import 'theme/theme_provider.dart';

/// The root widget of the application.
///
/// [KiteBootstrap] configures the application-level dependencies that
/// determine how the app is presented and navigated, including:
///
/// - Application routing through [appRouterProvider].
/// - Light and dark themes provided by [AppTheme].
/// - Runtime theme selection through [themeModeProvider].
/// - Global application metadata such as [AppConstants.appName].
///
/// Built with Kite 🪁
/// Flutter foundations, architecture, and developer tooling.
/// See: https://kite.orkitt.dev

class KiteBootstrap extends ConsumerWidget {
  const KiteBootstrap({super.key});
  @override
  Widget build(BuildContext context, WidgetRef ref) {
    final router = ref.watch(appRouterProvider);
    final themeMode = ref.watch(themeModeProvider);

    return KiteApp.router(
      title: AppConstants.appName,
      theme: AppTheme.light,
      darkTheme: AppTheme.dark,
      themeMode: themeMode,
      routerConfig: router,
      // Development tools:
      // debugShowCheckedModeBanner: false,
      // debugGrid: true,
      // debugShowKiteBanner: true,
    );
  }
}
