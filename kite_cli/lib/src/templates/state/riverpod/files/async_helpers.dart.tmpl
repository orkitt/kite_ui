class AsyncProviderListener<T> extends ConsumerWidget {
  const AsyncProviderListener({
    super.key,
    required this.provider,
    required this.child,
    this.onData,
    this.onError,
  });

  final ProviderListenable<AsyncValue<T>> provider;

  final Widget child;

  final void Function(BuildContext context, T value)? onData;

  final void Function(
    BuildContext context,
    Object error,
    StackTrace stackTrace,
  )?
  onError;

  @override
  Widget build(BuildContext context, WidgetRef ref) {
    ref.listen<AsyncValue<T>>(provider, (previous, next) {
      switch (next) {
        case AsyncData<T>(:final value):
          final sameValue =
              previous?.hasValue == true && previous?.value == value;

          if (!sameValue) {
            onData?.call(context, value);
          }

        case AsyncError<T>(:final error, :final stackTrace):
          final sameError =
              previous?.hasError == true && previous?.error == error;

          if (!sameError) {
            onError?.call(context, error, stackTrace);
          }

        case AsyncLoading<T>():
          break;
      }
    });

    return child;
  }
}

