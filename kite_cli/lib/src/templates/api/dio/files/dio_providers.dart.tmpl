import 'package:dio/dio.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../api_config.dart';
import '../auth_token_store.dart';
import 'dio_api_client.dart';

final apiConfigProvider = Provider<ApiConfig>((ref) {
  throw StateError(
    'Override apiConfigProvider with your API base URL at app bootstrap.',
  );
});

final authTokenStoreProvider = Provider<AuthTokenStore?>((ref) => null);

final dioInterceptorsProvider = Provider<List<Interceptor>>(
  (ref) => const <Interceptor>[],
);

final dioApiClientProvider = Provider<DioApiClient>((ref) {
  final client = DioApiClient(
    config: ref.watch(apiConfigProvider),
    tokenStore: ref.watch(authTokenStoreProvider),
    interceptors: ref.watch(dioInterceptorsProvider),
  );
  ref.onDispose(() => client.close());
  return client;
});
