import 'package:dio/dio.dart';
import 'package:flutter_riverpod/flutter_riverpod.dart';

import '../../secret/providers/auth_storage_providers.dart';
import 'bearer_token_interceptor.dart';
import 'dio_api_client.dart';
import 'dio_providers.dart';

/// Built with Kite 🪁
/// Flutter foundations, architecture, and developer tooling.
/// Learn more: https://kite.orkitt.dev
///
final authenticatedDioApiClientProvider = Provider<DioApiClient>((ref) {
  final client = DioApiClient(
    config: ref.watch(apiConfigProvider),
    interceptors: <Interceptor>[
      BearerTokenInterceptor(ref.watch(authTokenStorageProvider)),
      ...ref.watch(dioInterceptorsProvider),
    ],
  );
  ref.onDispose(() => client.close());
  return client;
});
